function enqueueCampaignEmails_(campaignId) {
  const campaign = findRecord_("CAMPAIGNS", campaignId);
  if (!campaign) throw new Error("Campaign not found: " + campaignId);

  const tasks = listRecords_("CAMPAIGN_TASKS").filter(function(task) {
    return (
      String(task.campaignId) === String(campaignId) &&
      String(task.status) === "Pending" &&
      Boolean(task.contactId)
    );
  });

  const sequences = listRecords_("EMAIL_SEQUENCES")
    .filter(function(sequence) {
      return (
        String(sequence.campaignType) === String(campaign.type) &&
        String(sequence.status) === "Active"
      );
    })
    .sort(function(a, b) {
      return Number(a.step || 0) - Number(b.step || 0);
    });

  if (!sequences.length) {
    throw new Error("No active email sequence for campaign type: " + campaign.type);
  }

  let queued = 0;

  tasks.forEach(function(task) {
    const contact = findRecord_("CONTACTS", task.contactId);
    const customer = findRecord_("CUSTOMERS", task.customerId);

    if (!contact || !contact.email) return;
    if (String(contact.status) === "Unsubscribed") return;
    if (String(contact.consent).toLowerCase() === "false") return;

    sequences.forEach(function(sequence) {
      const existing = listRecords_("EMAIL_QUEUE").some(function(queueItem) {
        return (
          String(queueItem.taskId) === String(task.id) &&
          String(queueItem.sequenceId) === String(sequence.id)
        );
      });

      if (existing) return;

      const variables = {
        firstName: contact.firstName || "",
        company: customer && customer.name ? customer.name : (contact.company || ""),
        service: customer && customer.recommendedService ? customer.recommendedService : "",
        owner: campaign.owner || "DGL"
      };

      upsertRecord_("EMAIL_QUEUE", {
        id: uuid_("EMQ"),
        campaignId: campaignId,
        sequenceId: sequence.id,
        taskId: task.id,
        contactId: contact.id,
        customerId: task.customerId,
        toEmail: contact.email,
        subject: mergeTemplate_(sequence.subject, variables),
        htmlBody: mergeTemplate_(sequence.htmlBody, variables),
        textBody: mergeTemplate_(sequence.textBody, variables),
        scheduledAt: addHoursIso_(nowIso_(), Number(sequence.delayHours || 0)),
        status: "Queued",
        sendMode: getConfigValue_("SEND_MODE") || DGL_CONFIG.SEND_MODE,
        createdAt: nowIso_()
      }, "EMQ");

      queued++;
    });
  });

  logActivity_(
    "Campaign emails queued",
    "emailMarketing",
    "campaign",
    campaignId,
    { queued: queued }
  );

  return { queued: queued };
}

function processEmailQueue() {
  const queue = listRecords_("EMAIL_QUEUE")
    .filter(function(item) {
      return (
        String(item.status) === "Queued" &&
        (!item.scheduledAt || new Date(item.scheduledAt) <= new Date())
      );
    })
    .slice(0, 50);

  let drafted = 0;
  let sent = 0;
  let errors = 0;

  queue.forEach(function(item) {
    try {
      const options = {
        htmlBody: item.htmlBody || "",
        name: DGL_CONFIG.DEFAULT_SENDER_NAME
      };

      if (String(item.sendMode).toUpperCase() === "SEND") {
        v6AuraAssertExternalAllowed_("GMAIL_SEND");
        GmailApp.sendEmail(
          item.toEmail,
          item.subject,
          item.textBody || stripHtml_(item.htmlBody),
          options
        );
        item.status = "Sent";
        item.sentAt = nowIso_();
        sent++;
      } else {
        const draft = GmailApp.createDraft(
          item.toEmail,
          item.subject,
          item.textBody || stripHtml_(item.htmlBody),
          options
        );
        item.gmailDraftId = draft.getId();
        item.status = "Drafted";
        drafted++;
      }

      item.error = "";
    } catch (error) {
      item.status = "Error";
      item.error = error.message;
      errors++;
      logError_("processEmailQueue", error, item);
    }

    upsertRecord_("EMAIL_QUEUE", item, "EMQ");
  });

  const result = {
    processed: queue.length,
    drafted: drafted,
    sent: sent,
    errors: errors
  };

  if (queue.length) {
    logActivity_(
      "Email queue processed",
      "emailMarketing",
      "queue",
      today_(),
      result,
      "System"
    );
  }

  return result;
}

function mergeTemplate_(template, variables) {
  let output = String(template || "");

  Object.keys(variables).forEach(function(key) {
    const pattern = new RegExp("\\{" + key + "\\}", "g");
    output = output.replace(pattern, String(variables[key] || ""));
  });

  return output;
}

function stripHtml_(html) {
  return String(html || "")
    .replace(/<[^>]*>/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

