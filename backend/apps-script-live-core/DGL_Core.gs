/* =========================
 * INSTALLATION / VALIDATION
 * ========================= */

function installDglMarketingOS() {
  const ss = getSpreadsheet_();
  ss.setSpreadsheetTimeZone(DGL_CONFIG.TIMEZONE);

  Object.keys(DGL_SCHEMA).forEach(function(sheetName) {
    const schema = DGL_SCHEMA[sheetName];
    let sh = ss.getSheetByName(sheetName);

    if (!sh) {
      sh = ss.insertSheet(sheetName);
    }

    if (sh.getMaxColumns() < schema.length) {
      sh.insertColumnsAfter(sh.getMaxColumns(), schema.length - sh.getMaxColumns());
    }

    sh.getRange(1, 1, 1, schema.length).setValues([schema]);
    sh.setFrozenRows(1);
    sh.getRange(1, 1, 1, schema.length)
      .setBackground("#05035C")
      .setFontColor("#FFFFFF")
      .setFontWeight("bold");

    sh.autoResizeColumns(1, Math.min(schema.length, 12));

    // Idempotent: never attempts to create a second filter.
    if (!sh.getFilter()) {
      sh.getRange(1, 1, Math.max(sh.getMaxRows(), 2), schema.length).createFilter();
    }
  });

  seedConfig_();
  createDriveStructure_();
  seedDefaultEmailSequences_();
  installTriggers_();
  refreshAnalytics();

  logActivity_(
    "Installation completed",
    "system",
    "system",
    "INSTALL",
    { spreadsheetId: DGL_CONFIG.SPREADSHEET_ID },
    "Installer"
  );

  const validation = validateDglInstallation();
  const result = {
    ok: validation.ok,
    spreadsheetId: DGL_CONFIG.SPREADSHEET_ID,
    spreadsheetUrl: getSpreadsheet_().getUrl(),
    apiKey: getApiKey_(),
    sendMode: getConfigValue_("SEND_MODE"),
    validation: validation,
    deployNext: "Implementar > Nueva implementación > Aplicación web"
  };

  console.log(JSON.stringify(result, null, 2));
  return result;
}

function validateDglInstallation() {
  const ss = getSpreadsheet_();
  const missingSheets = [];
  const headerErrors = [];

  Object.keys(DGL_SCHEMA).forEach(function(sheetName) {
    const sh = ss.getSheetByName(sheetName);
    if (!sh) {
      missingSheets.push(sheetName);
      return;
    }

    const expected = DGL_SCHEMA[sheetName];
    const actual = sh.getRange(1, 1, 1, expected.length).getValues()[0].map(String);
    if (JSON.stringify(actual) !== JSON.stringify(expected)) {
      headerErrors.push(sheetName);
    }
  });

  const triggerNames = ScriptApp.getProjectTriggers().map(function(t) {
    return t.getHandlerFunction();
  });

  const requiredTriggers = ["runDailyAutomation", "processEmailQueue", "refreshAnalytics"];
  const missingTriggers = requiredTriggers.filter(function(name) {
    return triggerNames.indexOf(name) === -1;
  });

  return {
    ok: missingSheets.length === 0 && headerErrors.length === 0 && missingTriggers.length === 0,
    missingSheets: missingSheets,
    headerErrors: headerErrors,
    missingTriggers: missingTriggers,
    spreadsheetUrl: ss.getUrl(),
    driveFolderId: PropertiesService.getScriptProperties().getProperty(DGL_CONFIG.DRIVE_FOLDER_PROPERTY) || "",
    apiKeyCreated: Boolean(PropertiesService.getScriptProperties().getProperty(DGL_CONFIG.API_KEY_PROPERTY))
  };
}

function seedConfig_() {
  const sh = getSheet_("CONFIG");
  const values = [
    ["SEND_MODE", DGL_CONFIG.SEND_MODE, "DRAFT crea borradores; SEND envía automáticamente", nowIso_()],
    ["DAILY_TRIGGER_HOUR", DGL_CONFIG.DAILY_TRIGGER_HOUR, "Hora diaria de automatización", nowIso_()],
    ["TIMEZONE", DGL_CONFIG.TIMEZONE, "Zona horaria operativa", nowIso_()],
    ["API_KEY", getApiKey_(), "Clave para solicitudes del frontend", nowIso_()]
  ];

  if (sh.getLastRow() > 1) {
    sh.getRange(2, 1, sh.getLastRow() - 1, 4).clearContent();
  }
  sh.getRange(2, 1, values.length, 4).setValues(values);
}

function createDriveStructure_() {
  const props = PropertiesService.getScriptProperties();
  const existingId = props.getProperty(DGL_CONFIG.DRIVE_FOLDER_PROPERTY);

  if (existingId) {
    try {
      DriveApp.getFolderById(existingId);
      return existingId;
    } catch (error) {
      props.deleteProperty(DGL_CONFIG.DRIVE_FOLDER_PROPERTY);
    }
  }

  const root = DriveApp.createFolder("DGL Marketing Execution OS");
  ["Campaign Assets", "Approvals", "Reports", "Exports", "Email Attachments"].forEach(function(name) {
    root.createFolder(name);
  });

  props.setProperty(DGL_CONFIG.DRIVE_FOLDER_PROPERTY, root.getId());
  return root.getId();
}

function installTriggers_() {
  const handlers = ["runDailyAutomation", "processEmailQueue", "refreshAnalytics"];

  ScriptApp.getProjectTriggers().forEach(function(trigger) {
    if (handlers.indexOf(trigger.getHandlerFunction()) !== -1) {
      ScriptApp.deleteTrigger(trigger);
    }
  });

  v6AuraNewTrigger_("runDailyAutomation")
    .timeBased()
    .everyDays(1)
    .atHour(DGL_CONFIG.DAILY_TRIGGER_HOUR)
    .create();

  v6AuraNewTrigger_("processEmailQueue")
    .timeBased()
    .everyHours(1)
    .create();

  v6AuraNewTrigger_("refreshAnalytics")
    .timeBased()
    .everyDays(1)
    .atHour(6)
    .create();
}

/* =========================
 * CONFIG / DATABASE
 * ========================= */

function getSpreadsheet_() {
  if (!DGL_CONFIG.SPREADSHEET_ID) {
    throw new Error("DGL_CONFIG.SPREADSHEET_ID is empty");
  }
  v6AuraAssertGoogleAccess_();
  return SpreadsheetApp.openById(v6AuraAssertNotProductionResource_(DGL_CONFIG.SPREADSHEET_ID, "DGL_SPREADSHEET_ID"));
}

function getSheet_(name) {
  const sh = getSpreadsheet_().getSheetByName(name);
  if (!sh) throw new Error("Missing sheet: " + name);
  return sh;
}

function getApiKey_() {
  const props = PropertiesService.getScriptProperties();
  let key = props.getProperty(DGL_CONFIG.API_KEY_PROPERTY);
  if (!key) {
    key = Utilities.getUuid().replace(/-/g, "");
    props.setProperty(DGL_CONFIG.API_KEY_PROPERTY, key);
  }
  return key;
}

function assertApiKey_(provided) {
  if (!provided || provided !== getApiKey_()) {
    throw new Error("Unauthorized");
  }
}

function nowIso_() {
  return Utilities.formatDate(new Date(), DGL_CONFIG.TIMEZONE, "yyyy-MM-dd'T'HH:mm:ssXXX");
}

function today_() {
  return Utilities.formatDate(new Date(), DGL_CONFIG.TIMEZONE, "yyyy-MM-dd");
}

function uuid_(prefix) {
  return (prefix || "ID") + "-" + Utilities.getUuid().split("-")[0].toUpperCase();
}

function addDays_(dateString, days) {
  const d = dateString ? new Date(dateString + "T12:00:00") : new Date();
  d.setDate(d.getDate() + Number(days || 0));
  return Utilities.formatDate(d, DGL_CONFIG.TIMEZONE, "yyyy-MM-dd");
}

function addHoursIso_(isoString, hours) {
  const d = isoString ? new Date(isoString) : new Date();
  d.setTime(d.getTime() + Number(hours || 0) * 60 * 60 * 1000);
  return Utilities.formatDate(d, DGL_CONFIG.TIMEZONE, "yyyy-MM-dd'T'HH:mm:ssXXX");
}

function headers_(sheetName) {
  const sh = getSheet_(sheetName);
  const lastCol = sh.getLastColumn();
  if (!lastCol) return [];
  return sh.getRange(1, 1, 1, lastCol).getValues()[0].map(String);
}

function rowsToObjects_(values, headers) {
  return values.map(function(row) {
    const obj = {};
    headers.forEach(function(header, index) {
      let value = row[index];
      if (typeof value === "string" && (value.indexOf("[") === 0 || value.indexOf("{") === 0)) {
        try {
          value = JSON.parse(value);
        } catch (error) {}
      }
      obj[header] = value;
    });
    return obj;
  });
}

function objectsToRows_(objects, headers) {
  return objects.map(function(obj) {
    return headers.map(function(header) {
      const value = obj[header];
      if (Array.isArray(value) || (value && typeof value === "object" && !(value instanceof Date))) {
        return JSON.stringify(value);
      }
      return value == null ? "" : value;
    });
  });
}

function listRecords_(sheetName, options) {
  const sh = getSheet_(sheetName);
  const lastRow = sh.getLastRow();
  const headers = headers_(sheetName);

  if (lastRow < 2 || headers.length === 0) return [];

  let records = rowsToObjects_(
    sh.getRange(2, 1, lastRow - 1, headers.length).getValues(),
    headers
  );

  const opts = options || {};

  if (opts.filters) {
    Object.keys(opts.filters).forEach(function(key) {
      const expected = String(opts.filters[key]).toLowerCase();
      records = records.filter(function(record) {
        return String(record[key] == null ? "" : record[key]).toLowerCase() === expected;
      });
    });
  }

  if (opts.search) {
    const query = String(opts.search).toLowerCase();
    records = records.filter(function(record) {
      return Object.keys(record).some(function(key) {
        return String(record[key]).toLowerCase().indexOf(query) !== -1;
      });
    });
  }

  return records;
}

function findRecord_(sheetName, id) {
  const records = listRecords_(sheetName);
  for (let i = 0; i < records.length; i++) {
    if (String(records[i].id) === String(id)) return records[i];
  }
  return null;
}

function upsertRecord_(sheetName, record, idPrefix) {
  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    const sh = getSheet_(sheetName);
    const headers = headers_(sheetName);
    const data = sh.getDataRange().getValues();
    const idIndex = headers.indexOf("id");

    if (idIndex < 0) {
      throw new Error(sheetName + " requires an id column");
    }

    if (!record.id) record.id = uuid_(idPrefix || "ID");

    const updatedAtIndex = headers.indexOf("updatedAt");
    const createdAtIndex = headers.indexOf("createdAt");

    if (updatedAtIndex >= 0) record.updatedAt = nowIso_();

    let rowNumber = -1;
    for (let rowIndex = 1; rowIndex < data.length; rowIndex++) {
      if (String(data[rowIndex][idIndex]) === String(record.id)) {
        rowNumber = rowIndex + 1;
        break;
      }
    }

    if (rowNumber < 0 && createdAtIndex >= 0 && !record.createdAt) {
      record.createdAt = nowIso_();
    }

    const existing = rowNumber > 0
      ? rowsToObjects_([data[rowNumber - 1]], headers)[0]
      : {};

    const merged = Object.assign({}, existing, record);
    const row = objectsToRows_([merged], headers)[0];

    if (rowNumber > 0) {
      sh.getRange(rowNumber, 1, 1, headers.length).setValues([row]);
    } else {
      sh.appendRow(row);
    }

    return merged;
  } finally {
    lock.releaseLock();
  }
}

function deleteRecord_(sheetName, id) {
  const sh = getSheet_(sheetName);
  const values = sh.getDataRange().getValues();
  const headers = values[0] || [];
  const idIndex = headers.indexOf("id");

  for (let rowIndex = 1; rowIndex < values.length; rowIndex++) {
    if (String(values[rowIndex][idIndex]) === String(id)) {
      sh.deleteRow(rowIndex + 1);
      return true;
    }
  }
  return false;
}

function getConfigValue_(key) {
  const records = listRecords_("CONFIG");
  for (let i = 0; i < records.length; i++) {
    if (String(records[i].key) === String(key)) return records[i].value;
  }
  return "";
}

function logActivity_(action, module, entityType, entityId, details, actor) {
  upsertRecord_("ACTIVITY_LOG", {
    id: uuid_("LOG"),
    timestamp: nowIso_(),
    actor: actor || Session.getActiveUser().getEmail() || "System",
    action: action,
    module: module,
    entityType: entityType,
    entityId: entityId,
    details: typeof details === "string" ? details : JSON.stringify(details || {})
  }, "LOG");
}

function logError_(functionName, error, payload) {
  try {
    upsertRecord_("ERROR_LOG", {
      id: uuid_("ERR"),
      timestamp: nowIso_(),
      functionName: functionName,
      message: error && error.message ? error.message : String(error),
      stack: error && error.stack ? error.stack : "",
      payload: JSON.stringify(payload || {})
    }, "ERR");
  } catch (ignored) {}
}

/* =========================
 * AUTOMATIONS
 * ========================= */

function runDailyAutomation() {
  const summary = {
    quotes: 0,
    reactivation: 0,
    retention: 0,
    growth: 0,
    tasksCreated: 0,
    emailsQueued: 0
  };

  try {
    summary.quotes = automateQuotedNotBooked_(summary);
    summary.reactivation = automateReactivation_(summary);
    summary.retention = automateRetention_(summary);
    summary.growth = automateGrowth_(summary);
    applyPlaybooks_();

    const activeCampaigns = listRecords_("CAMPAIGNS").filter(function(campaign) {
      return String(campaign.status) === "Active";
    });

    activeCampaigns.forEach(function(campaign) {
      try {
        const queued = enqueueCampaignEmails_(campaign.id);
        summary.emailsQueued += Number(queued.queued || 0);
      } catch (error) {
        // A campaign without a compatible sequence remains task-based.
      }
    });

    logActivity_(
      "Daily automation completed",
      "automation",
      "run",
      today_(),
      summary,
      "System"
    );

    return summary;
  } catch (error) {
    logError_("runDailyAutomation", error, summary);
    throw error;
  }
}

function ensureCampaign_(type, automationRule, defaults) {
  const campaigns = listRecords_("CAMPAIGNS");
  for (let i = 0; i < campaigns.length; i++) {
    const campaign = campaigns[i];
    if (
      String(campaign.automationRule) === automationRule &&
      ["Completed", "Cancelled"].indexOf(String(campaign.status)) === -1
    ) {
      return campaign;
    }
  }

  const campaign = Object.assign({
    id: uuid_("CMP"),
    type: type,
    automationRule: automationRule,
    status: "Draft",
    owner: "Marketing",
    approver: "Dirección Comercial",
    startDate: today_(),
    endDate: addDays_(today_(), 30),
    priority: "Alta",
    sent: 0,
    replies: 0,
    quotes: 0,
    loads: 0,
    revenue: 0,
    createdAt: nowIso_(),
    updatedAt: nowIso_()
  }, defaults || {});

  return upsertRecord_("CAMPAIGNS", campaign, "CMP");
}

function taskExists_(sourceType, sourceId, campaignId) {
  const tasks = listRecords_("CAMPAIGN_TASKS");
  return tasks.some(function(task) {
    return (
      String(task.sourceType) === String(sourceType) &&
      String(task.sourceId) === String(sourceId) &&
      String(task.campaignId) === String(campaignId) &&
      String(task.status) !== "Cancelled"
    );
  });
}

function createAutomationTask_(campaign, sourceType, sourceId, task) {
  if (taskExists_(sourceType, sourceId, campaign.id)) return false;

  upsertRecord_("CAMPAIGN_TASKS", Object.assign({
    id: uuid_("TSK"),
    campaignId: campaign.id,
    sourceType: sourceType,
    sourceId: sourceId,
    status: "Pending",
    createdAt: nowIso_()
  }, task), "TSK");

  return true;
}

function automateQuotedNotBooked_(summary) {
  const records = listRecords_("QUOTES").filter(function(quote) {
    return (
      Number(quote.daysNoResponse || 0) >= 3 &&
      ["Won", "Booked", "Closed"].indexOf(String(quote.status)) === -1
    );
  });

  if (!records.length) return 0;

  const campaign = ensureCampaign_(
    "Recuperación de Cotizaciones",
    "quoted-not-booked",
    {
      name: "AUTO · Quoted Not Booked Recovery",
      objective: "Recuperar cotizaciones sin respuesta",
      segment: "3+ días sin respuesta",
      channel: "Email + Llamada",
      kpi: "Cotizaciones recuperadas",
      expectedResult: "Conversión de cotización a carga",
      nextAction: "Revisar tareas generadas"
    }
  );

  records.forEach(function(quote) {
    const created = createAutomationTask_(campaign, "QUOTE", quote.id, {
      title: "Follow-up " + quote.customer + " · " + quote.service,
      owner: "Freight Manager",
      dueDate: Number(quote.daysNoResponse) >= 7 ? today_() : addDays_(today_(), 1),
      priority: Number(quote.daysNoResponse) >= 14 ? "Crítica" : "Alta",
      customerId: quote.customerId,
      contactId: quote.contactId,
      notes: quote.nextAction || ""
    });
    if (created) summary.tasksCreated++;
  });

  return records.length;
}

function automateReactivation_(summary) {
  const eligibleStatuses = ["Inactive-60", "Inactive-90", "Inactive-120", "Dormant-was-recurrent"];

  const records = listRecords_("CUSTOMERS").filter(function(customer) {
    return eligibleStatuses.indexOf(String(customer.status)) !== -1;
  });

  if (!records.length) return 0;

  const campaign = ensureCampaign_(
    "Reactivación",
    "reactivation-60",
    {
      name: "AUTO · Reactivación 60+ días",
      objective: "Reactivar cuentas con historial comercial",
      segment: "Inactive 60/90/120+",
      channel: "Email + Llamada",
      kpi: "Cuentas reactivadas",
      expectedResult: "5% de reactivación",
      nextAction: "Aprobar secuencia y ejecutar"
    }
  );

  records.forEach(function(customer) {
    const created = createAutomationTask_(campaign, "CUSTOMER", customer.id, {
      title: "Reactivar " + customer.name + " · " + customer.status,
      owner: customer.accountManager || "Freight Manager",
      dueDate: addDays_(today_(), customer.status === "Inactive-60" ? 2 : 0),
      priority: customer.tier === "Strategic" ? "Crítica" : "Alta",
      customerId: customer.id,
      contactId: customer.primaryContactId,
      notes: customer.nextAction || customer.coolingReason || ""
    });
    if (created) summary.tasksCreated++;
  });

  return records.length;
}

function automateRetention_(summary) {
  const records = listRecords_("CUSTOMERS").filter(function(customer) {
    return String(customer.status) === "At Risk";
  });

  if (!records.length) return 0;

  const campaign = ensureCampaign_(
    "Retención",
    "retention-risk",
    {
      name: "AUTO · Retención de cuentas en riesgo",
      objective: "Proteger continuidad de cuentas con caída de volumen",
      segment: "At Risk",
      channel: "Email + Account Management",
      kpi: "Cuentas retenidas",
      expectedResult: "0 cuentas estratégicas perdidas",
      nextAction: "Ejecutar plan de recuperación"
    }
  );

  records.forEach(function(customer) {
    upsertRecord_("RETENTION", {
      id: "RET-" + customer.id,
      customerId: customer.id,
      customer: customer.name,
      riskReason: customer.coolingReason,
      riskScore: Math.max(0, 100 - Number(customer.opportunityScore || 50)),
      status: "Open",
      campaignId: campaign.id,
      owner: customer.accountManager,
      nextAction: customer.nextAction,
      dueDate: addDays_(today_(), 1),
      createdAt: nowIso_(),
      updatedAt: nowIso_()
    }, "RET");

    const created = createAutomationTask_(campaign, "RETENTION", customer.id, {
      title: "Plan de retención · " + customer.name,
      owner: customer.accountManager || "Account Management",
      dueDate: addDays_(today_(), 1),
      priority: "Crítica",
      customerId: customer.id,
      contactId: customer.primaryContactId,
      notes: customer.coolingReason || ""
    });

    if (created) summary.tasksCreated++;
  });

  return records.length;
}

function automateGrowth_(summary) {
  const records = listRecords_("CUSTOMERS").filter(function(customer) {
    let services = customer.servicesUsed;

    if (typeof services === "string") {
      try {
        services = JSON.parse(services);
      } catch (error) {
        services = services.split(",").map(function(item) {
          return item.trim();
        }).filter(Boolean);
      }
    }

    return String(customer.status) === "Active" && Array.isArray(services) && services.length === 1;
  });

  if (!records.length) return 0;

  const campaign = ensureCampaign_(
    "Cross Selling",
    "mono-service-growth",
    {
      name: "AUTO · Cross Selling mono-servicio",
      objective: "Expandir share of wallet en cartera activa",
      segment: "Clientes activos con un solo servicio",
      channel: "Email + Sales Enablement",
