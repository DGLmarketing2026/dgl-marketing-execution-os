  var startedAt = new Date().toISOString();
  if (acquired) { Utilities.sleep(45000); }
  var releasedAt = new Date().toISOString();
  try { lock.releaseLock(); } catch (_) { }
  var out = { acquired: acquired, startedAt: startedAt, releasedAt: releasedAt };
  var file = DriveApp.createFile('ZZZ_LOCK_HOLD_TEST_' + new Date().toISOString(), JSON.stringify(out), MimeType.PLAIN_TEXT);
  Logger.log('FILE_URL=' + file.getUrl());
  return out;
}

function RUN_AURA_CAMPANA_A_GOLIVE_VERIFY_RESULT() {
  var rows = v6Rows_('MKT_EMAIL_QUEUE').filter(function(r){ return v6AuraEmailText_(r.campaignId) === CAMPANA_A_CAMPAIGN_ID_; });
  var counts = {};
  var byLang = { ES: 0, EN: 0, PT: 0 };
  rows.forEach(function(r){
    var s = String(r.status).toUpperCase();
    counts[s] = (counts[s]||0) + 1;
    if (s === 'SENT') {
      var lang = v6AuraEmailText_(r.preferredLanguage).toUpperCase();
      if (byLang[lang] !== undefined) byLang[lang]++;
    }
  });
  var sendMode = PropertiesService.getScriptProperties().getProperty(AURA_SEND_MODE_PROPERTY_KEY_);
  var reportRow = v6Rows_('MKT_AURA_EXECUTION_REPORT').filter(function(r){ return v6AuraEmailText_(r.reportRowId) === CAMPANA_A_CAMPAIGN_ID_; })[0] || null;
  var execRows = v6Rows_('MKT_CAMPAIGN_EXECUTIONS').filter(function(r){ return String(r.campaignId) === CAMPANA_A_CAMPAIGN_ID_; });
  var otherCampaignsSentRecently = v6Rows_('MKT_EMAIL_QUEUE').filter(function(r){
    var c = v6AuraEmailText_(r.campaignId);
    return c !== CAMPANA_A_CAMPAIGN_ID_ && String(r.status).toUpperCase() === 'SENT' && r.processedAt && new Date(r.processedAt).getTime() > (Date.now() - 15*60000);
  }).length;
  var out = {
    totalRows: rows.length,
    statusCounts: counts,
    byLanguageSent: byLang,
    sendModeAfterRun: sendMode,
    reportRow: reportRow,
    executions: execRows,
    otherCampaignsSentInLast15Min: otherCampaignsSentRecently
  };
  var file = DriveApp.createFile('ZZZ_CAMPANA_A_GOLIVE_VERIFY_' + new Date().toISOString(), JSON.stringify(out, null, 2), MimeType.PLAIN_TEXT);
  Logger.log('FILE_URL=' + file.getUrl());
  return out;
}


