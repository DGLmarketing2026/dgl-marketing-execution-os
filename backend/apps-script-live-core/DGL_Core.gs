// The ONLY human-triggered real-send entry point for Campaign A: the governed GO LIVE
// (v6AuraCampanaAGoLive_, MarketingV6AuraCampanaA.gs) -- promotes exactly the validated DRY_RUN
// jobs of the current family, re-runs preflight, sends through the governed Campaign A
// dispatcher and always restores AURA_SEND_MODE to DRY_RUN. The legacy pre-governance real-send
// path (v6AuraProcessCampaignQueue_ with simulate:false) is no longer reachable from here.
function RUN_AURA_CAMPANA_A_GO_LIVE() {
  return v6AuraCampanaAGoLive_();
}

function RUN_AURA_CAMPANA_A_GO_LIVE_TEST() {
  var result = v6AuraProcessCampaignQueue_(CAMPANA_A_CAMPAIGN_ID_, { simulate: true });
  var json = JSON.stringify(result, null, 2);
  var file = DriveApp.createFile('ZZZ_CAMPANA_A_GOLIVE_TEST_' + new Date().toISOString(), json, MimeType.PLAIN_TEXT);
  Logger.log('FILE_URL=' + file.getUrl());
  return result;
}
function RUN_AURA_CAMPANA_A_GOLIVE_SCOPED_DISPATCH_TESTS() {
  var out = { tests: {} };

  var t1 = v6AuraProcessCampaignQueue_(CAMPANA_A_CAMPAIGN_ID_, { simulate: true });
  out.tests.selectionAndPreflight = {
    status: t1.status, attempted: t1.attempted, sent: t1.sent, preflight: t1.preflight,
    otherCampaignsSent: t1.otherCampaignsSent
  };

  var beforeOther = v6Rows_('MKT_EMAIL_QUEUE').filter(function (r) {
    var c = v6AuraEmailText_(r.campaignId); var s = String(r.status).toUpperCase();
    return c !== CAMPANA_A_CAMPAIGN_ID_ && (s === 'PENDING' || s === 'DRY_RUN');
  }).map(function (r) { return r.jobId + ':' + r.status; });
  var afterOther = v6Rows_('MKT_EMAIL_QUEUE').filter(function (r) {
    var c = v6AuraEmailText_(r.campaignId); var s = String(r.status).toUpperCase();
    return c !== CAMPANA_A_CAMPAIGN_ID_ && (s === 'PENDING' || s === 'DRY_RUN');
  }).map(function (r) { return r.jobId + ':' + r.status; });
  out.tests.otherCampaignsUntouched = {
    beforeCount: beforeOther.length, afterCount: afterOther.length,
    identical: JSON.stringify(beforeOther) === JSON.stringify(afterOther)
  };

  var t3 = v6AuraProcessCampaignQueue_('CMP-SOME-OTHER-CAMPAIGN', { simulate: true });
  out.tests.scopeViolationRejected = { status: t3.status, reason: t3.reason };
  var preLock = LockService.getScriptLock();
  var preLockAcquired = false;
  try { preLockAcquired = preLock.tryLock(5000); } catch (e) { preLockAcquired = false; }
  var t4;
  if (preLockAcquired) {
    t4 = v6AuraProcessCampaignQueue_(CAMPANA_A_CAMPAIGN_ID_, { simulate: true });
    preLock.releaseLock();
  } else {
    t4 = { status: 'INCONCLUSIVE', reason: 'COULD_NOT_ACQUIRE_TEST_LOCK' };
  }
  out.tests.lockBusyAborts = { status: t4.status, reason: t4.reason };

  var scratchKey = 'AURA_CAMPANA_A_TEST_RESTORE_PROBE_';
  var props = PropertiesService.getScriptProperties();
  var scratchBefore = props.getProperty(scratchKey);
  var scratchLock = LockService.getScriptLock();
  scratchLock.tryLock(5000);
  var scratchAfter;
  try {
    props.setProperty(scratchKey, 'FLIPPED');
    throw new Error('SCRATCH_SIMULATED_FAULT');
  } catch (e) {
  } finally {
    if (scratchBefore === null || scratchBefore === undefined) { props.deleteProperty(scratchKey); }
    else { props.setProperty(scratchKey, scratchBefore); }
    scratchAfter = props.getProperty(scratchKey);
    try { scratchLock.releaseLock(); } catch (_) { }
  }
  out.tests.faultRestoresSendMode = {
    mechanismVerifiedViaScratchProperty: true,
    scratchBefore: scratchBefore, scratchAfter: scratchAfter, restored: scratchBefore === scratchAfter,
    note: 'Real AURA_SEND_MODE is never flipped when simulate=true (flip is strictly gated behind !simulate in v6AuraProcessCampaignQueue_) because auraProcessEmailQueue() runs on an active CLOCK trigger and does not itself use LockService, so it could race a real flip during a test. This proves the identical set/throw/finally/restore code shape restores state correctly, using a harmless scratch property instead of the real one.'
  };
  var campaignARows = v6Rows_('MKT_EMAIL_QUEUE').filter(function (r) { return v6AuraEmailText_(r.campaignId) === CAMPANA_A_CAMPAIGN_ID_; });
  var anyPending = campaignARows.filter(function (r) { return String(r.status).toUpperCase() === 'PENDING'; });
  out.tests.legacyDispatcherStructurallyExcluded = {
    campaignARowsCurrentlyPending: anyPending.length,
    note: 'auraProcessEmailQueue() only ever selects status===PENDING; this dispatcher never sets Campaign A rows to PENDING (DRY_RUN goes straight to SENT/FAILED/STOPPED/etc), so 0 is required here regardless of the CLOCK trigger timing.'
  };

  var json = JSON.stringify(out, null, 2);
  var file = DriveApp.createFile('ZZZ_CAMPANA_A_SCOPED_DISPATCH_TESTS_' + new Date().toISOString(), json, MimeType.PLAIN_TEXT);
  Logger.log('FILE_URL=' + file.getUrl());
  return out;
}

