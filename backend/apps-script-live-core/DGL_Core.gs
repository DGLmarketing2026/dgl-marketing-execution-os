                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        return { language: byTld, source: 'EMAIL_TLD_SIGNAL', reason: "email domain '" + domain + "' TLD maps to " + byTld + " per DGL policy step 3 (steps 1-2 found no signal: " + base.reason + ')' };
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            var byKeyword = v6AuraCampanaACompanyKeywordLanguage_(companyText);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                              if (byKeyword) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  return { language: byKeyword, source: 'ACCOUNT_COMPANY_KEYWORD_SIGNAL', reason: "account/company text '" + v6AuraEmailText_(companyText) + "' matched a step-4 keyword mapping to " + byKeyword + " (steps 1-3 found no signal)" };
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      return { language: 'EN', source: 'EN_FALLBACK_FINAL_NO_SIGNAL', reason: 'no contact/tab/account country signal (step 1-2), no matching email TLD (step 3), no matching account/company keyword (step 4) -- EN per DGL policy step 5 final fallback' };
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                      }

