function createCampaignFolder(campaignId) {
  const campaign = findRecord_("CAMPAIGNS", campaignId);
  if (!campaign) throw new Error("Campaign not found");

  const rootId = createDriveStructure_();
  const root = DriveApp.getFolderById(rootId);
  const folders = root.getFoldersByName("Campaign Assets");
  const parent = folders.hasNext() ? folders.next() : root.createFolder("Campaign Assets");
  const folderName = campaign.id + " - " + campaign.name;
  const existing = parent.getFoldersByName(folderName);
  const folder = existing.hasNext() ? existing.next() : parent.createFolder(folderName);

  return { id: folder.getId(), url: folder.getUrl() };
}

