function doGet(e) {
  // Public engagement tracking (?aura_t=o|c): HMAC-verified opaque tokens, no PII, no open
  // redirects (MarketingV6AuraTracking.gs). Every other request continues unchanged.
  if (typeof v6AuraTrackingHandle_ === "function") {
    var tracked = v6AuraTrackingHandle_(e);
    if (tracked) return tracked;
  }
  var v55 = handleMarketingV55Api_(e, "GET");
  if (v55) return v55;

  return handleRequest_(e, "GET");
}

function doPost(e) {
  var v55 = handleMarketingV55Api_(e, "POST");
  if (v55) return v55;

  return handleRequest_(e, "POST");
}


function handleRequest_(event, method) {
  const params = Object.assign({}, event && event.parameter ? event.parameter : {});
  let body = {};

  try {
    if (event && event.postData && event.postData.contents) {
      try {
        body = JSON.parse(event.postData.contents);
      } catch (error) {
        body = params.payload ? JSON.parse(params.payload) : params;
      }
    }

    const request = Object.assign({}, params, body);
    const action = request.action || "health";

    if (action !== "health" && action !== "submitLead") {
      assertApiKey_(request.apiKey);
    }

    const result = routeAction_(action, request, method);
    return jsonResponse_(
      { ok: true, result: result, timestamp: nowIso_() },
      request.callback
    );
  } catch (error) {
    logError_("handleRequest_", error, { params: params, method: method });

    return jsonResponse_(
      { ok: false, error: error.message, timestamp: nowIso_() },
      params.callback
    );
  }
}

function jsonResponse_(payload, callback) {
  if (callback) {
    return ContentService
      .createTextOutput(callback + "(" + JSON.stringify(payload) + ")")
      .setMimeType(ContentService.MimeType.JAVASCRIPT);
  }

  return ContentService
    .createTextOutput(JSON.stringify(payload))
    .setMimeType(ContentService.MimeType.JSON);
}

function routeAction_(action, request) {
  switch (action) {
    case "health":
      return {
        status: "online",
        service: "DGL Marketing Execution OS",
        version: "2.0.0"
      };

    case "bootstrap":
      return bootstrapData_();

    case "list":
      return listModule_(request.module, request);

    case "get":
      return getModuleRecord_(request.module, request.id);

    case "upsert":
      return upsertModuleRecord_(request.module, request.record || request);

    case "delete":
      return deleteModuleRecord_(request.module, request.id);

    case "runAutomation":
      return runDailyAutomation();

    case "processEmailQueue":
      return processEmailQueue();

    case "approve":
      return approveCampaign_(request);

    case "enqueueCampaign":
      return enqueueCampaignEmails_(request.campaignId);

    case "dashboard":
      return getDashboard_();

    case "validate":
      return validateDglInstallation();

      case "submitLead":
      return v6AcqSubmitLead_(request);

    default:
      throw new Error("Unknown action: " + action);
  }
}

function moduleSheet_(moduleName) {
  const map = DGL_CONFIG.MODULE_SHEETS;
  if (!map[moduleName]) throw new Error("Unknown module: " + moduleName);
  return map[moduleName];
}

function listModule_(moduleName, request) {
  const filters = request.filters
    ? (typeof request.filters === "string" ? JSON.parse(request.filters) : request.filters)
    : {};

  return listRecords_(
    moduleSheet_(moduleName),
    { filters: filters, search: request.search || "" }
  );
}

function getModuleRecord_(moduleName, id) {
  return findRecord_(moduleSheet_(moduleName), id);
}

function upsertModuleRecord_(moduleName, record) {
  const sheetName = moduleSheet_(moduleName);
  const prefixes = {
    campaigns: "CMP",
    campaignTasks: "TSK",
    contacts: "CON",
    customers: "CUS",
    quotes: "QTE",
    loads: "LOD",
    emailSequences: "SEQ",
    emailQueue: "EMQ",
    playbooks: "PLY",
    assets: "AST",
    abm: "ABM",
    retention: "RET",
    growth: "GRO",
    seoGeo: "SEO",
    approvals: "APR",
    analytics: "MET"
  };

  const saved = upsertRecord_(
    sheetName,
    record,
    prefixes[moduleName] || "ID"
  );

  logActivity_(
    "Record upserted",
    moduleName,
    moduleName,
    saved.id,
    saved
  );

  return saved;
}

function deleteModuleRecord_(moduleName, id) {
  const deleted = deleteRecord_(moduleSheet_(moduleName), id);

  if (deleted) {
    logActivity_(
      "Record deleted",
      moduleName,
      moduleName,
      id,
      {}
    );
  }

  return { deleted: deleted };
}

