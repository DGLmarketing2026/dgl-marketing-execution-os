var MKT_V6_PROVIDER_READY=false;
function v6ExecutionRecord_(payload,id){var p=payload||{},now=new Date().toISOString(),counts=p.audienceCounts||{};return {executionId:id,campaignId:String(p.campaignId||''),campaignName:String(p.campaignName||''),campaignType:String(p.campaignType||''),service:String(p.service||''),amOwner:String(p.amOwner||''),audienceAccountCount:Number(counts.accountCount||p.audienceAccountCount||0),eligibleContactCount:Number(counts.eligibleContactCount||p.eligibleContactCount||0),excludedContactCount:Number(counts.excludedContactCount||p.excludedContactCount||0),queuedCount:0,sentCount:0,bounceCount:0,failedCount:0,startedAt:'',completedAt:'',status:'CREATED',executionCsvDriveFileId:'',emailHtmlDriveFileId:'',copyDriveFileId:'',creativeDriveFileId:String(p.creativeDriveFileId||''),createdAt:now,updatedAt:now};}
function v6CreateExecution_(payload){var p=payload||{};if(!String(p.campaignId||'').trim())throw new Error('campaignId REQUIRED');var id=String(p.executionId||'').trim()||'EXEC-'+Utilities.getUuid().slice(0,8).toUpperCase(),existing=v6Rows_('MKT_CAMPAIGN_EXECUTIONS').filter(function(r){return String(r.executionId)===id;})[0];if(existing)return existing;var record=v6UpsertByKey_('MKT_CAMPAIGN_EXECUTIONS',['executionId'],v6ExecutionRecord_(p,id)),archive=p.archive?v6ArchiveExecution_(id,p.archive):{status:'ARCHIVE PENDING'};return {executionId:id,status:'CREATED',bulkProviderReady:MKT_V6_PROVIDER_READY,archive:archive,record:v6ExecutionStatus_({executionId:id})};}
function v6ExecutionGates_(p,row){var reasons=[];if(!row||row.status==='NOT FOUND')reasons.push('EXECUTION NOT PERSISTED');if(!p.marketingApproved)reasons.push('MARKETING APPROVAL REQUIRED');if(!p.audienceResolved)reasons.push('RECIPIENT RESOLUTION REQUIRED');if(p.frequencyStatus!=='CLEAR')reasons.push('FREQUENCY GUARD REQUIRED');if(!p.archiveConfigured)reasons.push('ARCHIVE CONFIGURATION REQUIRED');if(!row.executionCsvDriveFileId)reasons.push('AUDIENCE CSV ARCHIVE REQUIRED');if(!MKT_V6_PROVIDER_READY)reasons.push('BULK PROVIDER NOT CONFIGURED');return reasons;}
function v6QueueExecution_(payload){var p=payload||{},row=v6ExecutionStatus_(p),reasons=v6ExecutionGates_(p,row);if(reasons.length)return {status:'BLOCKED',blocked:true,reasons:reasons,executionId:p.executionId||''};row.status='QUEUED';row.queuedCount=Number(row.eligibleContactCount||0);row.updatedAt=new Date().toISOString();v6UpsertByKey_('MKT_CAMPAIGN_EXECUTIONS',['executionId'],row);return row;}
function v6StartExecution_(payload){var p=payload||{},row=v6ExecutionStatus_(p),reasons=v6ExecutionGates_(p,row);if(row.status!=='QUEUED')reasons.push('EXECUTION MUST BE QUEUED');if(reasons.length)return {status:'BLOCKED',blocked:true,reasons:reasons,executionId:p.executionId||''};row.status='ACTIVE';row.startedAt=new Date().toISOString();row.updatedAt=row.startedAt;v6UpsertByKey_('MKT_CAMPAIGN_EXECUTIONS',['executionId'],row);return row;}
function v6ExecutionStatus_(payload){var id=String((payload||{}).executionId||''),rows=v6Rows_('MKT_CAMPAIGN_EXECUTIONS').filter(function(r){return String(r.executionId)===id;});var row=rows[0]||{executionId:id,status:'NOT FOUND'};if(row.status==='COMPLETED'&&!row.executionCsvDriveFileId)row.status='ARCHIVE INCOMPLETE';return row;}
function v6ExecutionArchiveStatus_(payload){var row=v6ExecutionStatus_(payload),csv=!!row.executionCsvDriveFileId,html=!!row.emailHtmlDriveFileId,copy=!!row.copyDriveFileId,creative=!!row.creativeDriveFileId;return {executionId:row.executionId,csvArchiveReady:csv,htmlArchiveReady:html,copyArchiveReady:copy,creativeArchiveReady:creative,status:csv&&html&&copy&&creative?'ARCHIVE READY':'ARCHIVE PENDING'};}
